    "styles": ".entering { animation: fadeIn 0.5s ease forwards; } .exiting { animation: fadeOut 0.5s ease forwards; } @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } } @keyframes fadeOut { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(0.95); } } .slide-in { animation: slideIn 0.6s ease forwards; } .slide-out { animation: slideOut 0.6s ease forwards; } @keyframes slideIn { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } } @keyframes slideOut { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(40px); } } .info-card { background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; padding: 24px; color: #fff; font-family: system-ui, sans-serif; } .info-card h2 { margin: 0 0 12px; font-size: 22px; } .info-card p { margin: 0; font-size: 15px; line-height: 1.5; color: rgba(255,255,255,0.8); } .component-box { background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 16px; color: #fff; font-family: monospace; font-size: 14px; } .component-box a, .component-box [data-mise-action] { color: #64b5f6; cursor: pointer; text-decoration: underline; }",
    "playback": {
      "duration": null,
      "loop": false,
      "sync": {
        "withClock": true
      }
    },

