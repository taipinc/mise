{
  "version": "0.1",

  "meta": {
    "title": "Test 03 — Author CSS Overrides",
    "author": "Mise Dev",
    "description": "Demonstrates author CSS overriding every default player surface: title bar, close button, resize handle, content panels, playback bar, and element-level classNames.",
    "created": "2026-03-07",
    "modified": "2026-03-07"
  },

  "stage": {
    "viewBox": { "width": 1920, "height": 1080 },
    "scaling": true,
    "background": "",
    "poster": "",
    "styles": "@keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } } @keyframes fadeOut { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(0.95); } } @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } } @keyframes slideDown { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(20px); } } .entering { animation: fadeIn 0.4s ease forwards; } .exiting { animation: fadeOut 0.4s ease forwards; } .slide-up { animation: slideUp 0.5s ease forwards; } .slide-down { animation: slideDown 0.5s ease forwards; } .mise-title-bar { background: rgba(30, 60, 90, 0.9); } .mise-close-btn { background: rgba(180, 60, 60, 0.8); color: #fff; } .mise-close-btn:hover { background: #c0392b; } .mise-resize-handle { background: rgba(255, 255, 255, 0.15); } .mise-content { background: rgba(10, 20, 35, 0.85); border: 1px solid rgba(100, 160, 220, 0.25); } .mise-content h2 { margin: 0 0 8px; font-size: 18px; color: #7eb8e0; } .mise-content p { margin: 0; color: rgba(255, 255, 255, 0.7); } .mise-content code { background: rgba(255, 255, 255, 0.08); padding: 1px 5px; border-radius: 3px; font-size: 13px; } .mise-content [data-mise-action] { color: #5dade2; cursor: pointer; text-decoration: none; border-bottom: 1px dotted rgba(93, 173, 226, 0.4); } .mise-content [data-mise-action]:hover { color: #85c1e9; border-bottom-color: rgba(133, 193, 233, 0.6); } .custom-bar { height: 36px; bottom: 20px; left: 50%; width: 60%; transform: translateX(-50%); border-radius: 8px; background: linear-gradient(to right, rgba(10, 20, 35, 0.95), rgba(30, 60, 90, 0.95)); border: 1px solid rgba(100, 160, 220, 0.2); } .custom-bar .mise-play-pause-btn { color: #7eb8e0; width: 50px; height: 36px; font-size: 16px; } .custom-bar .mise-playhead { background: rgba(93, 173, 226, 0.7); border-radius: 4px; width: 28px; height: 36px; } .custom-bar .mise-scrub-track { height: 36px; } .rounded-frame { border-radius: 8px; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); } .accent-panel .mise-content { border-color: rgba(46, 204, 113, 0.3); } .accent-panel .mise-content h2 { color: #2ecc71; }",
    "playback": {
      "duration": null,
      "loop": false,
      "sync": {
        "withClock": true
      }
    },

    "playbackBar": {
      "visible": true,
      "interactive": true,
      "classNames": ["custom-bar"]
    }
  },

